{
  "name": "@rehab-trainer/mouthtrainer",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://mouth.trainerhub.cc",
  "rehabTrainer": {
    "role": "trainer"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/check-trainer-entrypoints.mjs && tsc -b && vite build && node ../../scripts/check-vite-html-shell.mjs dist/index.html && node ../../scripts/emit-pwa-assets.mjs dist && node ../../scripts/emit-official-game-pwas.mjs dist && node ../../scripts/check-seo-output.mjs",
    "test:entrypoints": "node ../../scripts/check-trainer-entrypoints.mjs",
    "test:production-shell": "node ../../scripts/check-vite-html-shell.mjs dist/index.html",
    "test:seo": "node ../../scripts/check-seo-output.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow/tfjs": "^4.22.0",
    "jspsych": "^8.3.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
