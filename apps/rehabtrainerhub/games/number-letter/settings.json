{
  "schemaVersion": 1,
  "gameId": "number-letter",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定數字字母切換難度與題數。",
        "en": "Configure quadrant task-switching settings."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "切換模式",
            "en": "Switching mode"
          },
          "description": {
            "zh-TW": "可選擇單一規則固定練習，或四象限輪替切換。",
            "en": "Choose single task pure block or alternating task shift."
          },
          "default": "alternating",
          "options": [
            {
              "value": "alternating",
              "label": {
                "zh-TW": "交替切換（經典象限轉換）",
                "en": "Alternating Switching"
              }
            },
            {
              "value": "number-only",
              "label": {
                "zh-TW": "數字判斷（單純奇偶數）",
                "en": "Number Pure Task"
              }
            },
            {
              "value": "letter-only",
              "label": {
                "zh-TW": "字母判斷（單純母子音）",
                "en": "Letter Pure Task"
              }
            }
          ]
        },
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "回合題數",
            "en": "Rounds"
          },
          "description": {
            "zh-TW": "設定本次活動題數。",
            "en": "Set total trials in this session."
          },
          "default": 24,
          "min": 12,
          "max": 48,
          "step": 4,
          "unit": {
            "zh-TW": "題",
            "en": "trials"
          }
        },
        {
          "key": "stimulusDurationMs",
          "type": "list",
          "label": {
            "zh-TW": "反應時限",
            "en": "Response time window"
          },
          "description": {
            "zh-TW": "每題等待作答的時間上限。",
            "en": "Maximum time window to make a classification."
          },
          "default": 3000,
          "options": [
            {
              "value": 2000,
              "label": {
                "zh-TW": "2.0 秒（緊湊）",
                "en": "2.0 seconds"
              }
            },
            {
              "value": 3000,
              "label": {
                "zh-TW": "3.0 秒（標準）",
                "en": "3.0 seconds"
              }
            },
            {
              "value": 4000,
              "label": {
                "zh-TW": "4.0 秒（從容）",
                "en": "4.0 seconds"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "作答時播放音效。",
            "en": "Play audio cues on responses."
          },
          "default": true
        }
      ]
    }
  ]
}