{
  "schemaVersion": 1,
  "gameId": "simon-says",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "目標序列長度",
            "en": "Target sequence length"
          },
          "description": {
            "zh-TW": "各條件改變下列活動需求；不同條件應分開分析。",
            "en": "These conditions alter the demands listed below; analyze conditions separately."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "5 項",
                "en": "5 items"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "7 項",
                "en": "7 items"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "9 項",
                "en": "9 items"
              }
            }
          ]
        },
        {
          "key": "lives",
          "type": "slider",
          "label": {
            "zh-TW": "可容許錯誤次數",
            "en": "Allowed failed sequences"
          },
          "default": 3,
          "min": 1,
          "max": 5,
          "step": 2,
          "unit": {
            "zh-TW": "次",
            "en": "lives"
          },
          "description": {
            "zh-TW": "錯誤後重播同一序列；可選 1、3、5 次。",
            "en": "A failed sequence is replayed; choose 1, 3 or 5 failures."
          }
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
          },
          "default": true
        }
      ]
    }
  ]
}
