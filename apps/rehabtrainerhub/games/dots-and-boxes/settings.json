{
  "schemaVersion": 1,
  "gameId": "dots-and-boxes",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "在點與點之間畫線；完成方格可得分並繼續操作。記錄當次步數、雙方方格數與結果。",
        "en": "Draw lines between dots. Closing a box scores a point and grants another turn; the session records moves, boxes and result."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "點陣大小",
            "en": "Dot grid size"
          },
          "description": {
            "zh-TW": "選擇每邊的點數：4、5 或 6 個點，分別形成 9、16 或 25 個方格。",
            "en": "Choose a grid of four, five or six dots per side, giving nine, sixteen or twenty-five boxes."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "4 × 4 點／9 格",
                "en": "4 × 4 dots / 9 boxes"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "5 × 5 點／16 格",
                "en": "5 × 5 dots / 16 boxes"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "6 × 6 點／25 格",
                "en": "6 × 6 dots / 25 boxes"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "完成方格、選到已畫線及遊戲結束時播放提示音。",
            "en": "Play cues when you close a box, choose an occupied line, and when the game ends."
          },
          "default": true
        }
      ]
    }
  ]
}
