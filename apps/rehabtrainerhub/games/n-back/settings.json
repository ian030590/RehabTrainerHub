{
  "schemaVersion": 1,
  "gameId": "n-back",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定工作記憶更新的比對步數與題數。",
        "en": "Configure comparison steps (N-back) and trial count for working memory updating."
      },
      "fields": [
        {
          "key": "nBackLevel",
          "type": "list",
          "label": {
            "zh-TW": "記憶步數 (N)",
            "en": "N-back Level"
          },
          "description": {
            "zh-TW": "1-back 與前一個比對；2-back 與前兩個比對。",
            "en": "1-back compares with 1 step back; 2-back compares with 2 steps back."
          },
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": {
                "zh-TW": "1-back（與前 1 個比較）",
                "en": "1-back (1 step back)"
              }
            },
            {
              "value": "2",
              "label": {
                "zh-TW": "2-back（與前 2 個比較）",
                "en": "2-back (2 steps back)"
              }
            },
            {
              "value": "3",
              "label": {
                "zh-TW": "3-back（與前 3 個比較）",
                "en": "3-back (3 steps back)"
              }
            }
          ]
        },
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "回合數",
            "en": "Rounds"
          },
          "description": {
            "zh-TW": "設定本次活動總題數。",
            "en": "Set total number of trials in this session."
          },
          "default": 20,
          "min": 10,
          "max": 50,
          "step": 5,
          "unit": {
            "zh-TW": "題",
            "en": "trials"
          }
        },
        {
          "key": "stimulusDurationMs",
          "type": "list",
          "label": {
            "zh-TW": "圖形展示時間",
            "en": "Display duration"
          },
          "description": {
            "zh-TW": "每張圖形在畫面呈現的時間長度。",
            "en": "Duration each symbol remains visible on screen."
          },
          "default": 2500,
          "options": [
            {
              "value": 1500,
              "label": {
                "zh-TW": "1.5 秒（快速）",
                "en": "1.5 seconds (Fast)"
              }
            },
            {
              "value": 2500,
              "label": {
                "zh-TW": "2.5 秒（標準）",
                "en": "2.5 seconds (Standard)"
              }
            },
            {
              "value": 3500,
              "label": {
                "zh-TW": "3.5 秒（從容）",
                "en": "3.5 seconds (Relaxed)"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在作答正確或錯誤時播放音效。",
            "en": "Play auditory cues for correct and incorrect answers."
          },
          "default": true
        }
      ]
    }
  ]
}
