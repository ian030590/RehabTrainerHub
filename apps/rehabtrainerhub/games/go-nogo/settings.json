{
  "schemaVersion": 1,
  "gameId": "go-nogo",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定持續專注與抑制點擊的難度與題數。",
        "en": "Configure sustained attention and response inhibition difficulty and trials."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "難度",
            "en": "Difficulty"
          },
          "description": {
            "zh-TW": "初級反應時間較寬鬆，高級刺激切換速度更快。",
            "en": "Beginner provides relaxed pace; advanced increases stimulus speed."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "初級（80% 通行，節奏平穩）",
                "en": "Beginner (80% Go, steady)"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "中級（75% 通行，標準節奏）",
                "en": "Intermediate (75% Go, standard)"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "高級（70% 通行，快速挑戰）",
                "en": "Advanced (70% Go, fast)"
              }
            }
          ]
        },
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "回合數",
            "en": "Rounds"
          },
          "description": {
            "zh-TW": "設定本次活動總題數。",
            "en": "Set total number of trials in this session."
          },
          "default": 30,
          "min": 15,
          "max": 60,
          "step": 5,
          "unit": {
            "zh-TW": "題",
            "en": "trials"
          }
        },
        {
          "key": "stimulusDurationMs",
          "type": "list",
          "label": {
            "zh-TW": "刺激停留時間",
            "en": "Stimulus display duration"
          },
          "description": {
            "zh-TW": "刺激圖示在畫面上停留的最大時間。",
            "en": "Maximum time the stimulus stays on screen."
          },
          "default": 1200,
          "options": [
            {
              "value": 800,
              "label": {
                "zh-TW": "0.8 秒（快速）",
                "en": "0.8 seconds (Fast)"
              }
            },
            {
              "value": 1200,
              "label": {
                "zh-TW": "1.2 秒（標準）",
                "en": "1.2 seconds (Standard)"
              }
            },
            {
              "value": 1600,
              "label": {
                "zh-TW": "1.6 秒（從容）",
                "en": "1.6 seconds (Relaxed)"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在點擊反應或錯誤時播放音效。",
            "en": "Play auditory cues for responses and mistakes."
          },
          "default": true
        }
      ]
    }
  ]
}
