{
  "schemaVersion": 1,
  "gameId": "stroop",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定色彩干擾抑制練習的難度與回合數。",
        "en": "Configure difficulty and round count for color-word interference training."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "難度",
            "en": "Difficulty"
          },
          "description": {
            "zh-TW": "初級以一致色彩為主，中級平衡出現，高級提高衝突干擾比例。",
            "en": "Beginner favors congruent stimuli, intermediate balances conditions, advanced increases incongruent conflict."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "初級（一致為主）",
                "en": "Beginner (Mostly congruent)"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "中級（標準平衡）",
                "en": "Intermediate (Balanced)"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "高級（高強度衝突）",
                "en": "Advanced (High conflict)"
              }
            }
          ]
        },
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "回合數",
            "en": "Rounds"
          },
          "description": {
            "zh-TW": "設定本次活動總題數。",
            "en": "Set total number of trials in this session."
          },
          "default": 20,
          "min": 10,
          "max": 60,
          "step": 5,
          "unit": {
            "zh-TW": "題",
            "en": "trials"
          }
        },
        {
          "key": "stimulusDurationMs",
          "type": "list",
          "label": {
            "zh-TW": "作答時間",
            "en": "Response time limit"
          },
          "description": {
            "zh-TW": "每題顯示並等待作答的最長時間。",
            "en": "Maximum time allowed to respond per trial."
          },
          "default": 2500,
          "options": [
            {
              "value": 1500,
              "label": {
                "zh-TW": "1.5 秒（快速）",
                "en": "1.5 seconds (Fast)"
              }
            },
            {
              "value": 2500,
              "label": {
                "zh-TW": "2.5 秒（標準）",
                "en": "2.5 seconds (Standard)"
              }
            },
            {
              "value": 4000,
              "label": {
                "zh-TW": "4.0 秒（從容）",
                "en": "4.0 seconds (Relaxed)"
              }
            },
            {
              "value": 0,
              "label": {
                "zh-TW": "不限時",
                "en": "No time limit"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在作答正確或錯誤時播放提示音。",
            "en": "Play auditory cues for correct and incorrect answers."
          },
          "default": true
        }
      ]
    }
  ]
}
