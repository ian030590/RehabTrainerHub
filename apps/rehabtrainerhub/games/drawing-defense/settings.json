{
  "schemaVersion": 1,
  "gameId": "drawing-defense",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "圖形出現節奏",
            "en": "Shape presentation schedule"
          },
          "description": {
            "zh-TW": "各條件改變下列活動需求；不同條件應分開分析。",
            "en": "These conditions alter the demands listed below; analyze conditions separately."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "清除後等待 2 秒",
                "en": "2 s after clearing"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "清除後立即出現",
                "en": "Immediately after clearing"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "每 3 秒出現，可重疊",
                "en": "Every 3 s, may overlap"
              }
            }
          ]
        },
        {
          "key": "durationSec",
          "type": "slider",
          "label": {
            "zh-TW": "活動時間",
            "en": "Session duration"
          },
          "description": {
            "zh-TW": "設定這次活動進行的時間。",
            "en": "Set how long this activity will run."
          },
          "default": 60,
          "min": 30,
          "max": 300,
          "step": 15,
          "unit": {
            "zh-TW": "秒",
            "en": "sec"
          }
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
          },
          "default": true
        }
      ]
    }
  ]
}
