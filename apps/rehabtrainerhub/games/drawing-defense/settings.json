{
  "schemaVersion": 1,
  "gameId": "drawing-defense",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "活動設定",
        "en": "Session settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "難度",
            "en": "Difficulty"
          },
          "description": {
            "zh-TW": "選擇這次活動的刺激與操作難度。",
            "en": "Choose the stimulus and control difficulty for this session."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "簡單",
                "en": "Easy"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "中等",
                "en": "Medium"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "困難",
                "en": "Hard"
              }
            }
          ]
        },
        {
          "key": "durationSec",
          "type": "slider",
          "label": {
            "zh-TW": "活動時間",
            "en": "Session duration"
          },
          "description": {
            "zh-TW": "設定這次活動進行的時間。",
            "en": "Set how long this activity will run."
          },
          "default": 60,
          "min": 30,
          "max": 300,
          "step": 15,
          "unit": {
            "zh-TW": "秒",
            "en": "sec"
          }
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
          },
          "default": true
        }
      ]
    }
  ]
}
