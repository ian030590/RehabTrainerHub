        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "難度",
            "en": "Difficulty"
          },
          "description": {
            "zh-TW": "選擇這次活動的刺激與操作難度。",
            "en": "Choose the stimulus and control difficulty for this session."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "簡單",
                "en": "Easy"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "中等",
                "en": "Medium"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "困難",
                "en": "Hard"
              }
            }
          ]
        },
        {
          "key": "drill",
          "type": "list",
          "label": {
            "zh-TW": "移動路徑",
            "en": "Movement path"
          },
          "default": "bounce",
          "options": [
            {
              "value": "bounce",
              "label": {
                "zh-TW": "反彈追蹤",
                "en": "Bounce tracking"
              }
            },
            {
              "value": "vertical",
              "label": {
                "zh-TW": "垂直移動",
                "en": "Vertical movement"
              }
            },
            {
              "value": "horizontal",
              "label": {
                "zh-TW": "水平移動",
                "en": "Horizontal movement"
              }
            },
            {
              "value": "random",
              "label": {
                "zh-TW": "隨機目標",
                "en": "Random targets"
              }
            }
          ]
        },
        {
          "key": "durationSec",
          "type": "list",
          "label": {
            "zh-TW": "活動時間",
            "en": "Session duration"
          },
          "default": 60,
          "options": [
            {
              "value": 45,
              "label": {
                "zh-TW": "45 秒",
                "en": "45 seconds"
              }
            },
            {
              "value": 60,
              "label": {
                "zh-TW": "60 秒",
                "en": "60 seconds"
              }
            },
            {
              "value": 90,
              "label": {
                "zh-TW": "90 秒",
                "en": "90 seconds"
              }
            }
          ]
        },
        {
          "key": "targetSizePercent",
          "type": "slider",
          "label": {
            "zh-TW": "目標大小",
            "en": "Target size"
          },
          "default": 100,
          "min": 75,
          "max": 130,
          "step": 5,
          "unit": {
            "zh-TW": "%",
            "en": "%"
          }
        },
        {
          "key": "speedPercent",
          "type": "slider",
          "label": {
            "zh-TW": "移動速度",
            "en": "Movement speed"
          },
          "default": 100,
          "min": 70,
          "max": 140,
          "step": 5,
          "unit": {
            "zh-TW": "%",
            "en": "%"
          }
        }
      ]
