{
  "name": "@rehab-trainer/rehabtrainerhub",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://trainerhub.cc",
  "rehabTrainer": {
    "role": "hub",
    "redirectDomains": [
      "motor.trainerhub.cc",
      "vision.trainerhub.cc",
      "brain.trainerhub.cc",
      "mouth.trainerhub.cc"
    ],
    "retiredProjects": [
      "motortrainer",
      "visiontrainer",
      "braintrainer",
      "mouthtrainer"
    ]
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsc --noEmit --incremental false -p tsconfig.json",
    "build": "node scripts/clean-next-output.mjs && next build && node scripts/build-training-runtimes.mjs && node ../../scripts/check-runtime-build-manifest.mjs && node ../../scripts/emit-pwa-assets.mjs out && node ../../scripts/emit-official-game-pwas.mjs out && node ../../scripts/check-official-game-pwa-output.mjs out && node ../../scripts/check-bundle-budgets.mjs --require-output && node ../../scripts/check-seo-output.mjs",
    "preview": "pnpm dlx serve out"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "fflate": "~0.8.2",
    "next": "^16.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@rehab-trainer/training-contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
