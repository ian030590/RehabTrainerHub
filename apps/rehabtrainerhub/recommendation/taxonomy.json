  "tags": [
    {
      "id": "attention.focused",
      "dimension": "attention",
      "icfCode": "b140",
      "labels": {
        "zh-TW": "集中性注意力",
        "en": "Focused attention"
      },
      "definition": {
        "zh-TW": "將注意導向一個明確出現的刺激。",
        "en": "Direct attention to a distinct stimulus when it appears."
      },
      "status": "active"
    },
    {
      "id": "attention.sustained",
      "dimension": "attention",
      "icfCode": "b1400",
      "labels": {
        "zh-TW": "持續性注意力",
        "en": "Sustained attention"
      },
      "definition": {
        "zh-TW": "在一連串刺激或等待期間持續監看，以免錯過目標。",
        "en": "Monitor a stream or a waiting period without missing the target."
      },
      "status": "active"
    },
    {
      "id": "attention.selective",
      "dimension": "attention",
      "icfCode": "b140",
      "labels": {
        "zh-TW": "選擇性注意力",
        "en": "Selective attention"
      },
      "definition": {
        "zh-TW": "在干擾刺激同時出現時，依指定特徵選出目標。",
        "en": "Select targets by a specified feature in the presence of distractors."
      },
      "status": "active"
    },
    {
      "id": "attention.alternating",
      "dimension": "attention",
      "icfCode": "b1401",
      "labels": {
        "zh-TW": "轉換性注意力",
        "en": "Alternating attention"
      },
      "definition": {
        "zh-TW": "輪流把注意移到兩項任務或兩種刺激來源。",
        "en": "Alternate attention between two tasks or sources of information."
      },
      "status": "active"
    },
    {
      "id": "attention.divided",
      "dimension": "attention",
      "icfCode": "b1402",
      "labels": {
        "zh-TW": "分配性注意力",
        "en": "Divided attention"
      },
      "definition": {
        "zh-TW": "同時監看兩項並行任務，並依各自要求作答。",
        "en": "Monitor two simultaneous tasks and respond to each as required."
      },
      "status": "active"
    },
    {
      "id": "executive.inhibition",
      "dimension": "executive",
      "icfCode": "b164",
      "labels": {
        "zh-TW": "反應抑制",
        "en": "Response inhibition"
      },
      "definition": {
        "zh-TW": "依停止或衝突線索，抑制已準備好或習慣性的反應。",
        "en": "Withhold a prepared or habitual response when a stop or conflict cue calls for it."
      },
      "status": "active"
    },
    {
      "id": "executive.shifting",
      "dimension": "executive",
      "icfCode": "b1643",
      "labels": {
        "zh-TW": "認知轉換",
        "en": "Shifting"
      },
      "definition": {
        "zh-TW": "根據提示或回饋，改用另一套判斷規則。",
        "en": "Switch to another decision rule in response to a cue or feedback."
      },
      "status": "active"
    },
    {
      "id": "executive.updating",
      "dimension": "executive",
      "icfCode": "b1440",
      "labels": {
        "zh-TW": "工作記憶更新",
        "en": "Working memory updating"
      },
      "definition": {
        "zh-TW": "新資訊出現時，依規則保留、替換或移除先前記住的項目。",
        "en": "Retain, replace, or drop remembered items as new information arrives."
      },
      "status": "active"
    },
    {
      "id": "higher_cognition.planning",
      "dimension": "higher_cognition",
      "icfCode": "b1641",
      "labels": {
        "zh-TW": "組織與計畫",
        "en": "Organization and planning"
      },
      "definition": {
        "zh-TW": "在行動前安排多個步驟或預想下一步的結果。",
        "en": "Organize several steps or anticipate the consequences of a move before acting."
      },
      "status": "active"
    },
    {
      "id": "higher_cognition.problem_solving",
      "dimension": "higher_cognition",
      "icfCode": "b1646",
      "labels": {
        "zh-TW": "問題解決",
        "en": "Problem solving"
      },
      "definition": {
        "zh-TW": "運用線索與限制條件推導能達成目標的解法。",
        "en": "Use clues and constraints to work out a solution that meets a goal."
      },
      "status": "active"
    },
    {
      "id": "working_memory.phonological_loop",
      "dimension": "working_memory",
      "icfCode": "b1440",
      "labels": {
        "zh-TW": "語音迴路",
        "en": "Phonological loop"
      },
      "definition": {
        "zh-TW": "暫時保留可念出的字母、數字或詞語，以供比較或回想。",
        "en": "Briefly hold pronounceable letters, digits, or words for comparison or recall."
      },
      "status": "active"
    },
    {
      "id": "working_memory.visuospatial_sketchpad",
      "dimension": "working_memory",
      "icfCode": "b1440",
      "labels": {
        "zh-TW": "視空間模板",
        "en": "Visuospatial sketchpad"
      },
      "definition": {
        "zh-TW": "短暫保留位置、順序或圖形排列，以供比對或重現。",
        "en": "Briefly hold positions, spatial order, or a layout for comparison or reproduction."
      },
      "status": "active"
    },
    {
      "id": "processing_speed.gs_processing_speed",
      "dimension": "processing_speed",
      "icfCode": "b147",
      "labels": {
        "zh-TW": "認知處理速度（Gs）",
        "en": "Processing speed (Gs)"
      },
      "definition": {
        "zh-TW": "在有限時間內連續完成多個熟悉而簡單的判斷。",
        "en": "Complete a series of familiar, straightforward decisions within a time limit."
      },
      "status": "active"
    },
    {
      "id": "processing_speed.gt_reaction_decision_speed",
      "dimension": "processing_speed",
      "icfCode": "b1470",
      "labels": {
        "zh-TW": "反應與決策速度（Gt）",
        "en": "Reaction and decision speed (Gt)"
      },
      "definition": {
        "zh-TW": "依離散訊號迅速作答，並以訊號出現至反應的時間計分。",
        "en": "Respond promptly to a discrete cue and score the time from cue onset to response."
      },
      "status": "active"
    },
    {
      "id": "quantitative.calculation",
      "dimension": "quantitative",
      "icfCode": "b172",
      "labels": {
        "zh-TW": "計算",
        "en": "Calculation"
      },
      "definition": {
        "zh-TW": "依題目要求執行加減等算術運算。",
        "en": "Carry out arithmetic such as addition or subtraction as the task requires."
      },
      "status": "active"
    },
    {
      "id": "time.time_experience",
      "dimension": "time",
      "icfCode": "b1802",
      "labels": {
        "zh-TW": "時間經驗",
        "en": "Experience of time"
      },
      "definition": {
        "zh-TW": "比較、估計或重現刺激持續的時間。",
        "en": "Compare, estimate, or reproduce how long a stimulus lasts."
      },
      "status": "active"
    },
    {
      "id": "visual_perception.oculomotor",
      "dimension": "visual_perception",
      "icfCode": "b215",
      "labels": {
        "zh-TW": "眼球動作控制",
        "en": "Oculomotor control"
      },
      "definition": {
        "zh-TW": "依 Leigh 與 Zee 的眼球動作子系統區分掃視、平穩追視與凝視。",
        "en": "Groups saccades, smooth pursuit, and fixation using the ocular motor subsystems described by Leigh and Zee (2015)."
      },
      "status": "active"
    },
    {
      "id": "visual_perception.oculomotor.saccade",
      "dimension": "visual_perception",
      "icfCode": "b2152",
      "labels": {
        "zh-TW": "掃視",
        "en": "Saccade"
      },
      "definition": {
        "zh-TW": "視線快速從一個位置移到另一個位置以取得目標資訊。",
        "en": "Move gaze rapidly between locations to acquire target information."
      },
      "status": "active",
      "parent": "visual_perception.oculomotor"
    },
