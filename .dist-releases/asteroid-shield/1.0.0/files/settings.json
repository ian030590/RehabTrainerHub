{
  "schemaVersion": 1,
  "gameId": "asteroid-shield",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "防護設定",
        "en": "Shield settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "生成間隔／基礎速度",
            "en": "Spawn interval / base speed"
          },
          "description": {
            "zh-TW": "各條件改變下列活動需求；不同條件應分開分析。",
            "en": "These conditions alter the demands listed below; analyze conditions separately."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "1.35 秒／120 px/s",
                "en": "1.35 s / 120 px/s"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "1.08 秒／165 px/s",
                "en": "1.08 s / 165 px/s"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "0.82 秒／215 px/s",
                "en": "0.82 s / 215 px/s"
              }
            }
          ]
        },
        {
          "key": "durationSec",
          "type": "slider",
          "label": {
            "zh-TW": "活動時間",
            "en": "Session duration"
          },
          "description": {
            "zh-TW": "設定這次活動進行的時間。",
            "en": "Set how long this activity will run."
          },
          "default": 90,
          "min": 30,
          "max": 300,
          "step": 15,
          "unit": {
            "zh-TW": "秒",
            "en": "sec"
          }
        },
        {
          "key": "sensitivity",
          "type": "slider",
          "label": {
            "zh-TW": "護盾大小級距",
            "en": "Shield size level"
          },
          "default": 5,
          "min": 1,
          "max": 10,
          "step": 1,
          "description": {
            "zh-TW": "護盾比例 = 70 + 級距 × 5（75–120%）；較大較容易攔截。此設定不是追蹤靈敏度。",
            "en": "Shield scale = 70 + level × 5 (75–120%); larger shields ease interception. This is a size control."
          }
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
          },
          "default": true
        }
      ]
    }
  ]
}
