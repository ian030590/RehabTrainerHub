                "zh-TW": "1 分鐘",
                "en": "1 minute"
              }
            },
            {
              "value": 180,
              "label": {
                "zh-TW": "3 分鐘",
                "en": "3 minutes"
              }
            },
            {
              "value": 300,
              "label": {
                "zh-TW": "5 分鐘",
                "en": "5 minutes"
              }
            }
          ]
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
