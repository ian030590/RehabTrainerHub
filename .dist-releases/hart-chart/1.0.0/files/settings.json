      "title": {
        "zh-TW": "視標設定",
        "en": "Chart settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "要求解碼字母數",
            "en": "Requested decoder letters"
          },
          "default": 10,
          "min": 5,
          "max": 30,
          "step": 5,
          "unit": {
            "zh-TW": "次",
            "en": "times"
          },
          "description": {
            "zh-TW": "依此數量產生字母解碼活動；不是眼球往返次數。實際字母數另存於結果。",
            "en": "Sets the requested decoder length, not a count of eye movements. Actual target count is stored in results."
          }
        },
        {
          "key": "chartSize",
          "type": "list",
          "label": {
            "zh-TW": "視標大小",
            "en": "Chart size"
          },
          "default": "medium",
          "options": [
            {
              "value": "large",
              "label": {
                "zh-TW": "大",
                "en": "Large"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "中",
                "en": "Medium"
              }
            },
            {
              "value": "small",
              "label": {
                "zh-TW": "小",
                "en": "Small"
              }
            }
          ],
          "description": {
            "zh-TW": "圖表初始縮放：大 1.25、中 1、小 0.75；遊玩中仍可調整，分析時需固定操作流程。",
            "en": "Initial chart scale: large 1.25, medium 1, small 0.75. In-game adjustments remain possible; standardize the procedure for analysis."
          }
        }
      ]
    }
  ]
}
