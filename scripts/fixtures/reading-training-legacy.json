{
  "settings": {
    "schemaVersion": 1,
    "gameId": "reading-training",
    "sections": [
      {
        "id": "training",
        "title": {
          "zh-TW": "閱讀設定",
          "en": "Reading settings"
        },
        "description": {
          "zh-TW": "設定值只用於這次活動。",
          "en": "These values apply only to this session."
        },
        "fields": [
          {
            "key": "passage",
            "type": "slider",
            "label": {
              "zh-TW": "文章材料",
              "en": "Passage material"
            },
            "default": 0,
            "description": {
              "zh-TW": "0＝隨機；1–3＝固定文章，可控制材料差異；重複有熟悉效應。編號依各語言素材檔名排序，不代表難度。",
              "en": "0 = random; 1–3 = fixed passage. Repetitions introduce familiarity. IDs follow sorted filenames within each language, not difficulty ranks."
            },
            "min": 0,
            "max": 3,
            "step": 1
          },
          {
            "key": "wordsPerMinute",
            "type": "slider",
            "label": {
              "zh-TW": "呈現速度",
              "en": "Presentation speed"
            },
            "default": 240,
            "min": 60,
            "max": 600,
            "step": 20,
            "unit": {
              "zh-TW": "片段／分",
              "en": "segments/min"
            },
            "description": {
              "zh-TW": "每分鐘呈現的故事文字片段數；此為刺激速度，不是實測閱讀速度。",
              "en": "Story tokens presented per minute; this is a stimulus rate, not measured reading speed."
            }
          },
          {
            "key": "crowding",
            "type": "slider",
            "label": {
              "zh-TW": "每批呈現文字片段數",
              "en": "Text tokens per display"
            },
            "default": 100,
            "min": 100,
            "max": 500,
            "step": 100,
            "unit": {
              "zh-TW": "%",
              "en": "%"
            },
            "description": {
              "zh-TW": "100＝每批 1 段，200＝2 段，依此類推；文字片段由故事分詞決定，並非標準化擁擠效應測量。",
              "en": "100 = 1 token, 200 = 2 tokens, and so on. Tokens follow story segmentation; this does not measure a standardized crowding effect."
            }
          },
          {
            "key": "contrast",
            "type": "slider",
            "label": {
              "zh-TW": "文字對比",
              "en": "Text contrast"
            },
            "default": 100,
            "min": 20,
            "max": 100,
            "step": 10,
            "unit": {
              "zh-TW": "%",
              "en": "%"
            },
            "description": {
              "zh-TW": "百分比先轉成插件的對数參數；較大代表文字較深。這是顯示灰階控制值，未做螢幕亮度校正。",
              "en": "Percent is converted to the plugin logarithmic parameter; larger values darken text. This controls display gray level without luminance calibration."
            }
          }
        ]
      }
    ]
  },
  "score": {
    "schema": "rehab-trainer.game-score/v1",
    "gameId": "reading-training",
    "presentation": {
      "primarySummaryKeys": [
        "correct",
        "finished",
        "presented",
        "configuredWpm"
      ],
      "qualitySummaryKeys": [],
      "defaultRoundMetricKey": "responseMs",
      "chartType": "line"
    },
    "columns": [
      {
        "key": "question",
        "label": {
          "zh": "文章內題號（1起算）",
          "en": "Question within passage (1-based)"
        },
        "sources": [
          "question_index"
        ]
      },
      {
        "key": "correct",
        "label": {
          "zh": "理解題正確（1／0）",
          "en": "Comprehension correct (1/0)"
        },
        "sources": [
          "correct"
        ]
      },
      {
        "key": "responseMs",
        "label": {
          "zh": "理解題作答時間",
          "en": "Question response time"
        },
        "sources": [
          "rt"
        ],
        "unit": "ms"
      },
      {
        "key": "choice",
        "label": {
          "zh": "選擇位置（0起算）",
          "en": "Chosen option (0-based)"
        },
        "sources": [
          "response"
        ]
      },
      {
        "key": "expectedChoice",
        "label": {
          "zh": "正確位置（0起算）",
          "en": "Correct option (0-based)"
        },
        "sources": [
          "correct_index"
        ]
      },
      {
        "key": "options",
        "label": {
          "zh": "選項數",
          "en": "Option count"
        },
        "sources": [
          "option_count"
        ]
      }
    ],
    "summary": [
      {
        "key": "questions",
        "label": {
          "zh": "理解題數",
          "en": "Comprehension questions"
        },
        "sources": [
          "questionCount"
        ]
      },
      {
        "key": "correct",
        "label": {
          "zh": "理解題答對數",
          "en": "Correct comprehension responses"
        },
        "sources": [
          "correctCount"
        ]
      },
      {
        "key": "presentationMs",
        "label": {
          "zh": "文字呈現流程時間（含倒數）",
          "en": "Presentation flow time (includes countdown)"
        },
        "sources": [
          "reading_time"
        ],
        "unit": "ms"
      },
      {
        "key": "wordCount",
        "label": {
          "zh": "文字片段數",
          "en": "Text token count"
        },
        "sources": [
          "total_words"
        ]
      },
      {
        "key": "configuredWpm",
        "label": {
          "zh": "設定呈現速率（片段／分）",
          "en": "Configured rate (segments/min)"
        },
        "sources": [
          "configuredWpm"
        ]
      },
      {
        "key": "presented",
        "label": {
          "zh": "已開始呈現片段數",
          "en": "Segments whose display began"
        },
        "sources": [
          "presented_segments"
        ]
      },
      {
        "key": "finished",
        "label": {
          "zh": "文章完整呈現（1／0）",
          "en": "Presentation completed (1/0)"
        },
        "sources": [
          "presentation_completed"
        ]
      },
      {
        "key": "passage",
        "label": {
          "zh": "文章編號（1起算）",
          "en": "Passage index (1-based)"
        },
        "sources": [
          "passage_index"
        ]
      },
      {
        "key": "language",
        "label": {
          "zh": "語言（0中文／1英文）",
          "en": "Language (0 Chinese / 1 English)"
        },
        "sources": [
          "language_code"
        ]
      }
    ]
  }
}
