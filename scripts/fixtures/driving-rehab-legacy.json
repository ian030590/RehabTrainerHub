{
  "settings": {
    "schemaVersion": 1,
    "gameId": "driving-rehab",
    "sections": [
      {
        "id": "training",
        "title": {
          "zh-TW": "模擬設定",
          "en": "Simulation settings"
        },
        "description": {
          "zh-TW": "依路線、操作方式及顯示效能分層分析反應、碰撞與偏離車道；遊戲結果不代表實際駕駛能力。",
          "en": "Stratify reaction, collision and lane departure data by route, controls and display performance; game results do not establish real driving ability."
        },
        "fields": [
          {
            "key": "difficulty",
            "type": "list",
            "label": {
              "zh-TW": "難度",
              "en": "Difficulty"
            },
            "description": {
              "zh-TW": "選擇這次活動的刺激與操作難度。",
              "en": "Choose the stimulus and control difficulty for this session."
            },
            "default": "medium",
            "options": [
              {
                "value": "easy",
                "label": {
                  "zh-TW": "簡單",
                  "en": "Easy"
                }
              },
              {
                "value": "medium",
                "label": {
                  "zh-TW": "中等",
                  "en": "Medium"
                }
              },
              {
                "value": "hard",
                "label": {
                  "zh-TW": "困難",
                  "en": "Hard"
                }
              }
            ]
          },
          {
            "key": "renderQuality",
            "type": "list",
            "label": {
              "zh-TW": "畫面品質",
              "en": "Rendering quality"
            },
            "default": "high",
            "options": [
              {
                "value": "high",
                "label": {
                  "zh-TW": "高",
                  "en": "High"
                }
              },
              {
                "value": "medium",
                "label": {
                  "zh-TW": "中",
                  "en": "Medium"
                }
              },
              {
                "value": "low",
                "label": {
                  "zh-TW": "低",
                  "en": "Low"
                }
              }
            ]
          },
          {
            "key": "controlMode",
            "type": "list",
            "label": {
              "zh-TW": "控制方式",
              "en": "Control method"
            },
            "default": "arrow",
            "options": [
              {
                "value": "arrow",
                "label": {
                  "zh-TW": "方向鍵",
                  "en": "Arrow keys"
                }
              },
              {
                "value": "wasd",
                "label": {
                  "zh-TW": "WASD 鍵",
                  "en": "WASD keys"
                }
              },
              {
                "value": "wheel",
                "label": {
                  "zh-TW": "方向盤／控制器",
                  "en": "Wheel or gamepad"
                }
              },
              {
                "value": "touch",
                "label": {
                  "zh-TW": "觸控",
                  "en": "Touch"
                }
              }
            ]
          },
          {
            "key": "redFlashEnabled",
            "type": "checkbox",
            "label": {
              "zh-TW": "危險紅光提示",
              "en": "Hazard red-flash cue"
            },
            "default": true
          }
        ]
      }
    ]
  },
