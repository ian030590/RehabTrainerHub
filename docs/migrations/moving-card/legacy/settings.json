{
  "schemaVersion": 1,
  "gameId": "moving-card",
  "sections": [
    {
      "id": "training",
      "title": {
        "zh-TW": "卡片設定",
        "en": "Card settings"
      },
      "description": {
        "zh-TW": "設定值只用於這次活動。",
        "en": "These values apply only to this session."
      },
      "fields": [
        {
          "key": "difficulty",
          "type": "list",
          "label": {
            "zh-TW": "視覺搜尋排列",
            "en": "Visual search arrangement"
          },
          "description": {
            "zh-TW": "各條件改變下列活動需求；不同條件應分開分析。",
            "en": "These conditions alter the demands listed below; analyze conditions separately."
          },
          "default": "medium",
          "options": [
            {
              "value": "easy",
              "label": {
                "zh-TW": "散佈移位",
                "en": "Scattered relocation"
              }
            },
            {
              "value": "medium",
              "label": {
                "zh-TW": "圓形排列",
                "en": "Circular arrangement"
              }
            },
            {
              "value": "hard",
              "label": {
                "zh-TW": "圓形排列並旋轉",
                "en": "Circular arrangement with rotation"
              }
            }
          ]
        },
        {
          "key": "rounds",
          "type": "slider",
          "label": {
            "zh-TW": "回合數",
            "en": "Rounds"
          },
          "description": {
            "zh-TW": "設定這次活動要完成的回合數。",
            "en": "Set the number of rounds in this session."
          },
          "default": 10,
          "min": 5,
          "max": 40,
          "step": 5,
          "unit": {
            "zh-TW": "回合",
            "en": "rounds"
          }
        },
        {
          "key": "soundEnabled",
          "type": "checkbox",
          "label": {
            "zh-TW": "聲音回饋",
            "en": "Sound feedback"
          },
          "description": {
            "zh-TW": "在操作與結果時播放提示音。",
            "en": "Play audio cues during interactions and results."
          },
          "default": true
        },
        {
          "key": "optionCount",
          "type": "slider",
          "label": {
            "zh-TW": "選項數量",
            "en": "Option count"
          },
          "default": 18,
          "min": 4,
          "max": 40,
          "step": 1
        },
        {
          "key": "optionMoveIntervalMs",
          "type": "slider",
          "label": {
            "zh-TW": "移動間隔（毫秒）",
            "en": "Movement interval (ms)"
          },
          "default": 800,
          "min": 200,
          "max": 5000,
          "step": 100
        },
        {
          "key": "targetPhysicalSizeMm",
          "type": "slider",
          "label": {
            "zh-TW": "目標大小（毫米）",
            "en": "Target size (mm)"
          },
          "default": 15,
          "min": 2,
          "max": 100,
          "step": 1
        },
        {
          "key": "optionPhysicalSizeMm",
          "type": "slider",
          "label": {
            "zh-TW": "選項大小（毫米）",
            "en": "Option size (mm)"
          },
          "default": 10,
          "min": 2,
          "max": 80,
          "step": 1
        }
      ]
    }
  ]
}
